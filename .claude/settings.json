{
  "permissions": {
    "allow": [
      "Bash(harness --project-root .:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git checkout main:*)",
      "Bash(git switch main:*)",
      "Bash(git merge:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "harness hook cross-review-nudge --project-root \"$CLAUDE_PROJECT_DIR\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "harness hook block-dangerous --project-root \"$CLAUDE_PROJECT_DIR\" || exit 2"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "harness hook tdd-guard --project-root \"$CLAUDE_PROJECT_DIR\""
          }
        ]
      }
    ]
  }
}
