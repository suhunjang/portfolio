{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "harness hook block-dangerous --project-root . || exit 2"
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "harness hook tdd-guard --project-root ."
          }
        ]
      }
    ]
  }
}
