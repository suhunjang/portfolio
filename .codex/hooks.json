{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash scripts/hooks/block-dangerous.sh || exit 2" }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          { "type": "command", "command": "python3 scripts/hooks/tdd-guard.py" }
        ]
      }
    ]
  }
}
