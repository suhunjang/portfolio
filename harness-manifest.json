{
  "schemaVersion": 1,
  "distribution": {"name": "discord-claude-harness", "version": "1.0.0"},
  "profiles": ["base", "ui"],
  "entries": [
    {"path": ".claude/commands/harness.md", "ownership": "managed"},
    {"path": ".claude/commands/review.md", "ownership": "managed"},
    {"path": ".claude/skills/cross-review/SKILL.md", "ownership": "managed"},
    {"path": ".codex/hooks.json", "ownership": "managed"},
    {"path": ".gitattributes", "ownership": "managed"},
    {"path": ".python-version", "ownership": "managed"},
    {"path": "harness-manifest.json", "ownership": "managed"},
    {"path": "pytest.ini", "ownership": "managed"},
    {"path": "scripts/approval.py", "ownership": "managed"},
    {"path": "scripts/bootstrap_venv.py", "ownership": "managed"},
    {"path": "scripts/conftest.py", "ownership": "managed"},
    {"path": "scripts/cross_review.py", "ownership": "managed"},
    {"path": "scripts/execute.py", "ownership": "managed"},
    {"path": "scripts/harness.py", "ownership": "managed"},
    {"path": "scripts/hooks/block-dangerous.sh", "ownership": "managed"},
    {"path": "scripts/hooks/cross-review-nudge.sh", "ownership": "managed"},
    {"path": "scripts/hooks/tdd-guard.sh", "ownership": "managed"},
    {"path": "scripts/hooks/test_hooks.py", "ownership": "managed"},
    {"path": "scripts/plan_manifest.py", "ownership": "managed"},
    {"path": "scripts/plan_session.py", "ownership": "managed"},
    {"path": "scripts/project_init.py", "ownership": "managed"},
    {"path": "scripts/review_plan.py", "ownership": "managed"},
    {"path": "scripts/runner.py", "ownership": "managed"},
    {"path": "scripts/runtime.py", "ownership": "managed"},
    {"path": "scripts/test_approval.py", "ownership": "managed"},
    {"path": "scripts/test_cross_review.py", "ownership": "managed"},
    {"path": "scripts/test_distribution_contract.py", "ownership": "managed"},
    {"path": "scripts/test_execute.py", "ownership": "managed"},
    {"path": "scripts/test_execute_gates.py", "ownership": "managed"},
    {"path": "scripts/test_plan_manifest.py", "ownership": "managed"},
    {"path": "scripts/test_plan_session.py", "ownership": "managed"},
    {"path": "scripts/test_project_init.py", "ownership": "managed"},
    {"path": "scripts/test_review_plan.py", "ownership": "managed"},
    {"path": "scripts/test_runner.py", "ownership": "managed"},
    {"path": "scripts/test_runtime.py", "ownership": "managed"},
    {"path": "templates/project/.harness/policy.json", "ownership": "managed"},
    {"path": "templates/project/CLAUDE.md.template", "ownership": "managed"},
    {"path": "templates/project/claude-settings.json.template", "ownership": "managed"},
    {"path": "templates/project/docs/PRD.md", "ownership": "managed"},
    {"path": "templates/project/docs/UI_GUIDE.md", "ownership": "managed"},
    {"path": "templates/project/gitignore.template", "ownership": "managed"},
    {"path": "templates/project/phases/index.json", "ownership": "managed"},

    {"path": "docs/PRD.md", "ownership": "seed",
     "source": "templates/project/docs/PRD.md", "profiles": ["base", "ui"]},
    {"path": "docs/UI_GUIDE.md", "ownership": "seed",
     "source": "templates/project/docs/UI_GUIDE.md", "profiles": ["ui"]},
    {"path": "phases/index.json", "ownership": "seed",
     "source": "templates/project/phases/index.json", "profiles": ["base", "ui"]},
    {"path": ".harness/policy.json", "ownership": "seed",
     "source": "templates/project/.harness/policy.json", "profiles": ["base", "ui"]},

    {"path": "CLAUDE.md", "ownership": "merge-required",
     "source": "templates/project/CLAUDE.md.template", "profiles": ["base", "ui"],
     "requirementsVersion": 1,
     "validators": [{"kind": "contains", "required": [
       "<!-- harness:begin -->", "<!-- harness:end -->", "하네스 모드 하나",
       "APPROVE <ISSUE> PLAN", ".harness/policy.json", "./.venv/bin/python scripts/harness.py"]}]},
    {"path": ".gitignore", "ownership": "merge-required",
     "source": "templates/project/gitignore.template", "profiles": ["base", "ui"],
     "requirementsVersion": 1,
     "validators": [{"kind": "lines", "required": [
       "__pycache__/", ".venv/", "/.harness/runtime/", "/.harness/transactions/",
       "/.harness/install.lock", "/.harness/policy.local.json", ".claude/.cross-review-state"]}]},
    {"path": ".claude/settings.json", "ownership": "merge-required",
     "source": "templates/project/claude-settings.json.template", "profiles": ["base", "ui"],
     "requirementsVersion": 1,
     "validators": [{"kind": "claude-settings",
       "allow": ["Bash(./.venv/bin/python scripts/harness.py:*)"],
       "deny": ["Bash(git push:*)", "Bash(git checkout main:*)", "Bash(git switch main:*)",
                "Bash(git merge:*)", "Bash(git reset --hard:*)"],
       "hooks": [
         {"event": "Stop", "matcher": "",
          "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/cross-review-nudge.sh\""},
         {"event": "PreToolUse", "matcher": "Bash",
          "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/block-dangerous.sh\""},
         {"event": "PreToolUse", "matcher": "Edit|Write",
          "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/tdd-guard.sh\""}]}]}
  ],
  "sourceOnly": [
    ".claude/settings.json",
    ".gitignore",
    "CLAUDE.md",
    "README.md",
    "docs/ADR.md",
    "docs/ARCHITECTURE.md",
    "docs/MIGRATION_AUDIT.md",
    "docs/examples/operator-policy.json",
    "docs/examples/operator-policy.local.json",
    "phases/index.json",
    "scripts/test_distribution_audit.py",
    "scripts/test_docs_contract.py"
  ]
}
